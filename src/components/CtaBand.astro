---
import { SITE, PROJET_ACHAT } from '../data/site';
---
<section class="wrap cta-section">
  <div class="cta-band">
    <h2 class="heading">Prêt à trouver le bon bien ?</h2>
    <div class="cta-actions">
      <a href={PROJET_ACHAT} class="pill pill-cream">Décrire mon projet</a>
      <a href="/rendez-vous" class="pill pill-outline-light">Prendre rendez-vous</a>
      <a href={SITE.phoneHref} class="pill pill-outline-light">{SITE.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-section { padding-bottom: clamp(56px, 7vw, 90px); }
  .cta-band { border-radius: 32px; background: var(--color-accent-2-700); color: var(--color-bg); padding: clamp(36px, 6vw, 80px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px; }
  h2 { font-size: clamp(34px, 4.8vw, 68px); line-height: 1; letter-spacing: -.02em; max-width: 14ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .pill { padding: 0 28px; }
</style>
