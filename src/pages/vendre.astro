---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import NotAgency from '../components/NotAgency.astro';
import { META, PHOTOS, VENTE_STEPS, PROJET_VENTE } from '../data/site';
const [title, description] = META.vendre;
---
<Base title={title} description={description}>
  <section data-screen-label="Vendre" class="wrap page-top intro">
    <div class="intro-text">
      <p class="eyebrow">Vendre</p>
      <h1 class="page-h1">Vendez votre bien à Roanne, au bon prix.</h1>
      <p class="lead">Estimation offerte, puis mise en relation directe avec ma base d'acheteurs en recherche active. Vous restez maître de votre vente.</p>
      <a href={PROJET_VENTE} class="pill pill-accent">Demander mon estimation gratuite</a>
    </div>
    <div class="intro-img"><Photo photo={PHOTOS.vente} alt="Propriétaire remettant les clés de son bien" eager /></div>
  </section>

  <section class="wrap steps-section">
    <div class="note-wrap">
      <NotAgency><strong>Je ne suis pas une agence.</strong> Je ne prends pas de mandat de vente : je présente gratuitement votre bien aux acheteurs que j'accompagne, et vous vendez en direct.</NotAgency>
    </div>
    <div class="steps">
      {VENTE_STEPS.map((s) => (
        <div class="step">
          <span class="eyebrow">{s.n}</span>
          <h3 class="heading">{s.t}</h3>
          <p>{s.d}</p>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro { padding-bottom: clamp(56px, 7vw, 90px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .intro-text { display: flex; flex-direction: column; gap: 24px; }
  .intro h1 { text-wrap: balance; }
  .intro .lead { max-width: 520px; }
  .intro .pill { align-self: flex-start; }
  .intro-img { aspect-ratio: 4 / 4.4; border-radius: 36px; overflow: hidden; background: var(--color-surface); }
  .steps-section { padding-bottom: clamp(72px, 10vw, 120px); }
  .note-wrap { margin-bottom: clamp(40px, 5vw, 64px); }
  .note-wrap :global(.note) { padding: 22px 26px; }
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: clamp(24px, 3vw, 40px); }
  .step { display: flex; flex-direction: column; gap: 12px; border-top: 1px solid var(--color-text); padding-top: 22px; }
  .step h3 { font-size: 22px; letter-spacing: -.02em; }
  .step p { font-size: 16px; line-height: 1.6; color: var(--color-neutral-800); }
</style>
