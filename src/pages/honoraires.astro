---
import Base from '../layouts/Base.astro';
import NotAgency from '../components/NotAgency.astro';
import { META, OFFER } from '../data/site';
const [title, description] = META.honoraires;
const offers = [
  { kicker: 'Pour démarrer · prestation de conseil', t: 'Étude de votre projet', d: "Je m'engage pleinement sur chaque recherche, pour des clients qui ont un vrai projet. Cette étude le confirme : budget et financement vérifiés, secteurs et stratégie définis, cahier des charges écrit qui vous est remis. Elle est à vous, que la chasse aboutisse ou non.", price: `${OFFER.studyPrice} €` },
  { kicker: 'À la carte', t: 'Accompagnement & compte rendu de visite', d: 'Vous avez repéré un bien ? Je le visite et vous remets un compte rendu écrit : gros postes de travaux, points de vigilance, prix conseillé pour votre offre.', price: 'Sur devis' },
  { kicker: 'Vendeurs', t: 'Estimation & mise en relation', d: "Avis de valeur argumenté et présentation de votre bien aux acheteurs que j'accompagne. Gratuit pour le vendeur, sans engagement.", price: 'Offert' },
];
---
<Base title={title} description={description}>
  <section data-screen-label="Honoraires" class="page-top hono">
    <p class="eyebrow">Honoraires</p>
    <h1 class="page-h1">Des honoraires clairs, dès le départ.</h1>
    <p class="lead">Vous ne payez la recherche que si vous achetez : mes honoraires de recherche ne sont dus qu'à la signature de l'acte authentique chez le notaire. Seule l'étude de votre projet, une prestation de conseil distincte, est facturée au démarrage.</p>
    <div class="offers">
      <div class="offer offer-main">
        <div class="offer-text">
          <span class="kicker">Acheteurs · uniquement au succès</span>
          <h2 class="heading">Chasse de bien</h2>
          <span class="desc">Recherche, visites, compte rendu, négociation et suivi jusqu'à l'acte. Calculés sur le prix d'achat, minimum {OFFER.feeMin}, dus le jour de la signature chez le notaire. Pas d'achat, pas d'honoraires.</span>
        </div>
        <span class="heading price">{OFFER.feeRate}</span>
      </div>
      {offers.map((o) => (
        <div class="offer">
          <div class="offer-text">
            <span class="kicker">{o.kicker}</span>
            <h2 class="heading">{o.t}</h2>
            <span class="desc">{o.d}</span>
          </div>
          <span class="heading price">{o.price}</span>
        </div>
      ))}
    </div>
    <div class="note-wrap"><NotAgency /></div>
    <p class="legal">Barème TTC affiché conformément à l'arrêté du 26 janvier 2017. Mandats de recherche conclus par LIBERTINVEST, SAS au capital de 1 000 €, RCS Roanne 897 992 806. Carte professionnelle « Transaction » en cours d'obtention auprès de la CCI : aucun mandat n'est signé avant sa délivrance.</p>
  </section>
</Base>

<style>
  .hono { max-width: 1080px; margin: 0 auto; padding-inline: clamp(18px, 4vw, 40px); padding-bottom: clamp(72px, 10vw, 120px); }
  .hono > .eyebrow { margin-bottom: 18px; }
  .hono h1 { max-width: 14ch; }
  .hono .lead { margin: 26px 0 48px; max-width: 600px; }
  .offers { display: flex; flex-direction: column; gap: 16px; }
  .offer { border-radius: 24px; border: 1px solid rgba(32, 30, 29, .16); padding: clamp(24px, 3.5vw, 40px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; }
  .offer-main { background: var(--color-accent-2-700); color: var(--color-bg); border: 0; }
  .offer-text { display: flex; flex-direction: column; gap: 8px; max-width: 540px; }
  .kicker { font-size: 14px; font-weight: 600; color: var(--color-neutral-700); }
  .offer-main .kicker { color: inherit; opacity: .7; }
  .offer h2 { font-size: 28px; letter-spacing: -.015em; }
  .desc { font-size: 16px; line-height: 1.55; color: var(--color-neutral-800); }
  .offer-main .desc { color: inherit; opacity: .85; }
  .price { font-size: clamp(34px, 4.5vw, 56px); letter-spacing: -.015em; white-space: nowrap; }
  .note-wrap { margin-top: 16px; }
  .legal { margin-top: 28px; font-size: 14px; line-height: 1.6; color: var(--color-neutral-700); }
</style>
